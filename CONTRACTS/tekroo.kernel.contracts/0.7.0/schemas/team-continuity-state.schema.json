{
  "$id": "https://contracts.tekroo.ai/tekroo.kernel.contracts/0.7.0/schemas/team-continuity-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "control_state": {
            "const": "ACTIVE"
          }
        },
        "required": [
          "control_state"
        ]
      },
      "then": {
        "properties": {
          "admission_open": {
            "const": true
          },
          "unresolved_execution_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "control_state": {
            "enum": [
              "QUIESCING",
              "SUSPENDED",
              "RECONCILING"
            ]
          }
        },
        "required": [
          "control_state"
        ]
      },
      "then": {
        "properties": {
          "admission_open": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "admission_open": {
      "type": "boolean"
    },
    "continuity_policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "continuity_policy_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "control_state": {
      "enum": [
        "ACTIVE",
        "QUIESCING",
        "SUSPENDED",
        "RECONCILING"
      ],
      "type": "string"
    },
    "health_requirement_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "kind": {
      "const": "system"
    },
    "last_transition_event_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "operating_posture": {
      "enum": [
        "CONTINUOUS",
        "PLANNED_SUSPEND_CAPABLE"
      ],
      "type": "string"
    },
    "power_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "unresolved_execution_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "kind",
    "revision",
    "operating_posture",
    "control_state",
    "power_epoch",
    "admission_open",
    "continuity_policy_revision",
    "continuity_policy_digest",
    "health_requirement_digest",
    "unresolved_execution_ids",
    "last_transition_event_id"
  ],
  "title": "Team host-continuity control state",
  "type": "object"
}
