{
  "$id": "https://contracts.tekroo.ai/tekroo.kernel.contracts/0.10.0/schemas/conformance-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contractIdentity": {
      "const": "tekroo.kernel.contracts/0.10.0"
    },
    "manifestSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profile": {
      "minLength": 1,
      "type": "string"
    },
    "reportSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reportType": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.6.0"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "INCONCLUSIVE"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "reportType",
    "contractIdentity",
    "manifestSha256",
    "profile",
    "status",
    "reportSha256"
  ],
  "title": "Conformance report",
  "type": "object"
}
