{
  "$defs": {
    "Ownership": {
      "additionalProperties": false,
      "properties": {
        "assigned_event_id": {
          "anyOf": [
            {
              "$ref": "./core.schema.json#/$defs/UUIDv7"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_fqn": {
          "anyOf": [
            {
              "$ref": "./core.schema.json#/$defs/ActorFQN"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownership_version": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "owner_fqn",
        "ownership_version",
        "assigned_event_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.tekroo.ai/tekroo.kernel.contracts/0.12.0/schemas/aggregate-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "enum": [
            "RUNNABLE",
            "BLOCKED"
          ]
        },
        "id": {
          "$ref": "./core.schema.json#/$defs/UUIDv7"
        },
        "kind": {
          "const": "story"
        },
        "lifecycle_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership"
        },
        "phase": {
          "enum": [
            "DRAFT",
            "READY",
            "PLANNING",
            "ACTIVE",
            "COMPLETED",
            "ACCEPTED",
            "CLOSED"
          ]
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "scope_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "condition",
        "id",
        "kind",
        "lifecycle_epoch",
        "ownership",
        "phase",
        "revision",
        "scope_revision"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "enum": [
            "RUNNABLE",
            "BLOCKED"
          ]
        },
        "id": {
          "$ref": "./core.schema.json#/$defs/UUIDv7"
        },
        "kind": {
          "const": "task"
        },
        "lifecycle_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership"
        },
        "phase": {
          "enum": [
            "PLANNED",
            "READY",
            "ACTIVE",
            "COMPLETED",
            "CLOSED"
          ]
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "scope_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "condition",
        "id",
        "kind",
        "lifecycle_epoch",
        "ownership",
        "phase",
        "revision",
        "scope_revision"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "admission_open": {
          "type": "boolean"
        },
        "continuity_policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "continuity_policy_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "control_state": {
          "enum": [
            "ACTIVE",
            "QUIESCING",
            "SUSPENDED",
            "RECONCILING"
          ],
          "type": "string"
        },
        "health_requirement_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "const": "system"
        },
        "last_transition_event_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "operating_posture": {
          "enum": [
            "CONTINUOUS",
            "PLANNED_SUSPEND_CAPABLE"
          ],
          "type": "string"
        },
        "power_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "unresolved_execution_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 1024,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "revision",
        "operating_posture",
        "control_state",
        "power_epoch",
        "admission_open",
        "continuity_policy_revision",
        "continuity_policy_digest",
        "health_requirement_digest",
        "unresolved_execution_ids",
        "last_transition_event_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "authentication_binding_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "delivery_binding_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "const": "human-participant"
        },
        "principal": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "HUMAN"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        "profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "profile_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "role_binding_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision",
        "principal",
        "status",
        "profile_id",
        "profile_revision",
        "profile_digest",
        "role_binding_ids",
        "authentication_binding_ids",
        "delivery_binding_ids"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "accepted_human_ids": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "canonical_question_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "confidentiality": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED"
          ],
          "type": "string"
        },
        "deadline_at": {
          "format": "date-time",
          "type": "string"
        },
        "declared_effect": {
          "enum": [
            "ADVISORY_ONLY",
            "AUTHORITY_IF_AUTHORIZED",
            "EVIDENCE_ONLY"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "const": "human-interaction"
        },
        "phase": {
          "enum": [
            "CLOSED",
            "COLLECTING",
            "EXPIRED",
            "OPEN",
            "SATISFIED"
          ],
          "type": "string"
        },
        "question_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "response_policy": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "EXACT_ONE"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "ANY_ONE"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "ALL"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "QUORUM"
                },
                "quorum": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "quorum"
              ],
              "type": "object"
            }
          ]
        },
        "response_specification_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "selected_human_ids": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "revision",
        "phase",
        "question_revision",
        "canonical_question_digest",
        "response_specification_digest",
        "selected_human_ids",
        "accepted_human_ids",
        "response_policy",
        "declared_effect",
        "confidentiality",
        "deadline_at"
      ],
      "type": "object"
    },
    {
      "$ref": "./work-budget-account.schema.json"
    },
    {
      "$ref": "./work-invocation.schema.json"
    }
  ],
  "title": "Story and task aggregate state"
}
