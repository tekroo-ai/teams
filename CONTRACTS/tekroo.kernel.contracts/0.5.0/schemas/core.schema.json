{
  "$defs": {
    "ActorFQN": {
      "pattern": "^(?:[a-z0-9]|[a-z0-9][a-z0-9-]{0,61}[a-z0-9])::(?:[a-z0-9]|[a-z0-9][a-z0-9-]{0,61}[a-z0-9])-[1-9][0-9]{0,19}$",
      "type": "string"
    },
    "AggregatePrecondition": {
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "$ref": "#/$defs/AggregateRef"
        },
        "expected_revision": {
          "$ref": "#/$defs/ExpectedRevision"
        }
      },
      "required": [
        "aggregate",
        "expected_revision"
      ],
      "type": "object"
    },
    "AggregateRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/UUIDv7"
        },
        "kind": {
          "enum": [
            "completion-review",
            "escalation",
            "evidence",
            "execution",
            "release-plan",
            "story",
            "system",
            "task"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "ContractManifestIdentity": {
      "const": "tekroo.kernel.contracts/0.5.0"
    },
    "DagParent": {
      "additionalProperties": false,
      "properties": {
        "edge_kind": {
          "enum": [
            "CAUSAL",
            "RESPONSE",
            "RETRY",
            "DERIVATION",
            "SUPERSESSION"
          ]
        },
        "parent_event_id": {
          "$ref": "#/$defs/UUIDv7"
        }
      },
      "required": [
        "parent_event_id",
        "edge_kind"
      ],
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/UUIDv7"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "evidence_id",
        "sha256"
      ],
      "type": "object"
    },
    "ExecutionTuple": {
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/UUIDv7"
        },
        "fencing_epoch": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "execution_id",
        "fencing_epoch"
      ],
      "type": "object"
    },
    "ExpectedRevision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "const": "MUST_NOT_EXIST"
        }
      ]
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "ACTOR",
            "HUMAN",
            "SERVICE",
            "POLICY"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "UUIDv7": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://contracts.tekroo.ai/tekroo.kernel.contracts/0.5.0/schemas/core.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tekroo kernel core values"
}
