{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tekroo.ai/tekroo.event-export.contracts/0.1.0/schemas/event-export.schema.json",
  "title": "Tekroo read-only event export protocol",
  "type": "object",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "source_id", "limit", "wait_millis"],
      "properties": {
        "protocol_version": {"const": "1.0.0"},
        "request_id": {"$ref": "#/$defs/uuidv7"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "cursor": {"type": "string", "minLength": 1, "maxLength": 16384},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "wait_millis": {"type": "integer", "minimum": 1, "maximum": 30000}
      }
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "contract_manifest", "event_type", "event_version", "event_bytes_base64", "event_bytes_sha256", "event_bytes_length", "cursor"],
      "properties": {
        "event_id": {"$ref": "#/$defs/uuidv7"},
        "contract_manifest": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "event_version": {"type": "string", "minLength": 1},
        "event_bytes_base64": {"type": "string", "minLength": 1},
        "event_bytes_sha256": {"$ref": "#/$defs/digest"},
        "event_bytes_length": {"type": "integer", "minimum": 1},
        "cursor": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "source_id", "source_contract_manifest", "source_contract_manifest_sha256", "status", "records", "next_cursor"],
      "properties": {
        "protocol_version": {"const": "1.0.0"},
        "request_id": {"$ref": "#/$defs/uuidv7"},
        "source_id": {"type": "string", "minLength": 1},
        "source_contract_manifest": {"const": "tekroo.kernel.contracts/0.7.0"},
        "source_contract_manifest_sha256": {"const": "e2b9b5224a860a3eaa07451cf48fb5ac16a440b22b8dd592ff1662c1cff67f16"},
        "status": {"enum": ["RECORDS", "CAUGHT_UP", "RESYNC_REQUIRED"]},
        "records": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/eventRecord"}},
        "next_cursor": {"type": "string", "minLength": 1, "maxLength": 16384},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "code", "retryable"],
      "properties": {
        "protocol_version": {"const": "1.0.0"},
        "request_id": {"$ref": "#/$defs/uuidv7"},
        "code": {"enum": ["INVALID_REQUEST", "UNAUTHENTICATED", "UNAUTHORIZED", "RATE_LIMITED", "DEADLINE_EXCEEDED", "SOURCE_UNAVAILABLE", "INTERNAL_ERROR"]},
        "retryable": {"type": "boolean"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/failure"}
  ]
}
