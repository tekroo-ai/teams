{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "summary",
    "evidence",
    "message_proposals",
    "work_product"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "outcome": {
      "enum": [
        "blocked",
        "completed",
        "failed",
        "needs_decision"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "message_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "recipient",
          "body"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^tekroo\\.message\\."
          },
          "recipient": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "object"
          }
        }
      }
    },
    "work_product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_type",
        "stories",
        "design_constraints"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "result_type": {
          "const": "FEATURE_SPECIFICATION"
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description",
              "acceptance_criteria",
              "priority"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "acceptance_criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "priority": {
                "enum": [
                  "LOW",
                  "NORMAL",
                  "HIGH",
                  "CRITICAL"
                ]
              }
            }
          }
        },
        "design_constraints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
