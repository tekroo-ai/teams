{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "summary",
    "evidence",
    "message_proposals",
    "work_product"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "outcome": {
      "enum": [
        "blocked",
        "completed",
        "failed",
        "needs_decision"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "message_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "recipient",
          "body"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^tekroo\\.message\\."
          },
          "recipient": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "object"
          }
        }
      }
    },
    "work_product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "result_type": {
          "const": "FEATURE_EXECUTION_PLAN"
        },
        "source_design_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "handoffs": {
          "type": "array", "maxItems": 16384,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["provider_task_index", "consumer_task_index", "capability", "contract"],
            "properties": {
              "provider_task_index": {"type": "integer", "minimum": 0, "maximum": 127},
              "consumer_task_index": {"type": "integer", "minimum": 0, "maximum": 127},
              "capability": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"},
              "contract": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        },
        "architecture": {
          "description": "Architecture rationale as prose or ordered paragraphs.",
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 65536},
            {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "design_decisions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 4096},
              {"type": "object", "additionalProperties": false, "required": ["decision"], "properties": {
                "decision": {"type": ["string", "array"], "minLength": 1, "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
                "rationale": {"type": ["string", "array"], "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}}
              }}
            ]
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story_index",
              "title",
              "description",
              "acceptance_criteria",
              "purpose",
              "complexity",
              "risk",
              "attempt_limit",
              "review_round_limit"
            ],
            "properties": {
              "story_index": {"type": "integer", "minimum": 0, "maximum": 31},
              "title": {"type": "string", "minLength": 1, "maxLength": 256},
              "description": {"type": "string", "minLength": 1, "maxLength": 65536},
              "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
              "covers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
              "depends_on": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
              "validates": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
              "write_scope": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
              "purpose": {"enum": ["INVESTIGATION", "IMPLEMENTATION", "VALIDATION", "REVIEW", "REPAIR", "HANDOFF", "REPLAN", "PROMOTION", "ESCALATION"]},
              "complexity": {"type": "integer", "minimum": 1, "maximum": 10},
              "risk": {
                "description": "Classification only; explain the risk in the task description.",
                "enum": [
                  "LOW",
                  "MODERATE",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "critical_path": {"type": "boolean"},
              "attempt_limit": {"type": "integer", "minimum": 1, "maximum": 16},
              "review_round_limit": {"type": "integer", "minimum": 1, "maximum": 8}
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "outcome": {
        "const": "completed"
      }
    }
  },
  "then": {
    "properties": {
      "work_product": {
        "required": [
          "schema_version",
          "result_type",
          "source_design_digest",
          "architecture",
          "tasks",
          "handoffs"
        ]
      }
    }
  }
}
