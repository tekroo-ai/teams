#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: teams-install-local ABSOLUTE_INSTALL_ROOT" >&2
  exit 2
fi

INSTALL_ROOT=$1
case "$INSTALL_ROOT" in /*) ;; *) echo "install root must be absolute" >&2; exit 2 ;; esac

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(dirname -- "$SCRIPT_DIR")
BIN_DIR=$INSTALL_ROOT/bin
SCRIPT_TARGET=$INSTALL_ROOT/scripts

/bin/mkdir -p "$BIN_DIR" "$SCRIPT_TARGET"
/bin/chmod 700 "$INSTALL_ROOT" "$BIN_DIR" "$SCRIPT_TARGET"

TEAMSD_TEMP=$BIN_DIR/teamsd.new.$$
TEAMSCTL_TEMP=$BIN_DIR/teamsctl.new.$$

cleanup() {
  /bin/rm -f "$TEAMSD_TEMP" "$TEAMSCTL_TEMP"
}
trap cleanup EXIT HUP INT TERM

cd -- "$REPOSITORY_ROOT"
/usr/bin/env go build -trimpath -o "$TEAMSD_TEMP" ./cmd/teamsd
/usr/bin/env go build -trimpath -o "$TEAMSCTL_TEMP" ./cmd/teamsctl
/bin/chmod 700 "$TEAMSD_TEMP" "$TEAMSCTL_TEMP"
/bin/mv "$TEAMSD_TEMP" "$BIN_DIR/teamsd"
/bin/mv "$TEAMSCTL_TEMP" "$BIN_DIR/teamsctl"

for NAME in teams-service teams-start teams-stop teams-restart teams-status; do
  /usr/bin/install -m 700 "$SCRIPT_DIR/$NAME" "$SCRIPT_TARGET/$NAME"
done

echo "installed Teams binaries and lifecycle scripts under $INSTALL_ROOT"
echo "automatic startup was not configured"
