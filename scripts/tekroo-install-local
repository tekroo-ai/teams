#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: tekroo-install-local ABSOLUTE_INSTALL_ROOT" >&2
  exit 2
fi

INSTALL_ROOT=$1
case "$INSTALL_ROOT" in /*) ;; *) echo "install root must be absolute" >&2; exit 2 ;; esac

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(dirname -- "$SCRIPT_DIR")
BIN_DIR=$INSTALL_ROOT/bin
SCRIPT_TARGET=$INSTALL_ROOT/scripts

/bin/mkdir -p "$BIN_DIR" "$SCRIPT_TARGET"
/bin/chmod 700 "$INSTALL_ROOT" "$BIN_DIR" "$SCRIPT_TARGET"

TEKROOD_TEMP=$BIN_DIR/tekrood.new.$$
TEKROO_TEMP=$BIN_DIR/tekroo.new.$$

cleanup() {
  /bin/rm -f "$TEKROOD_TEMP" "$TEKROO_TEMP"
}
trap cleanup EXIT HUP INT TERM

cd -- "$REPOSITORY_ROOT"
/usr/bin/env go build -trimpath -o "$TEKROOD_TEMP" ./cmd/tekrood
/usr/bin/env go build -trimpath -o "$TEKROO_TEMP" ./cmd/tekroo
/bin/chmod 700 "$TEKROOD_TEMP" "$TEKROO_TEMP"
/bin/mv "$TEKROOD_TEMP" "$BIN_DIR/tekrood"
/bin/mv "$TEKROO_TEMP" "$BIN_DIR/tekroo"

for NAME in tekroo-service tekroo-start tekroo-stop tekroo-restart tekroo-status; do
  /usr/bin/install -m 700 "$SCRIPT_DIR/$NAME" "$SCRIPT_TARGET/$NAME"
done

echo "installed Teams binaries and lifecycle scripts under $INSTALL_ROOT"
echo "automatic startup was not configured"
