    {
      "id": "GITPROVIDER-001-EXACT-FF",
      "status": "PASS",
      "tests": [
        "TestProviderFastForwardsOnlyExactPlannedHeadAndReplaysAlreadyMerged",
        "TestProviderExecutesCumulativeOrderedHeadsAndRetainsQualifiedBase"
      ],
      "evidenceFloor": "Only the exact planned head can advance the base ref, by compare-and-swap and FF-only ancestry, while cumulative ordered heads retain the qualified base identity."
    },
    {
      "id": "GITPROVIDER-002-NO-IMPROVISATION",
      "status": "PASS",
      "tests": [
        "TestProviderRejectsChangedHeadDivergedBaseAndIdempotencyReuseWithoutMutation"
      ],
      "evidenceFloor": "Changed heads, diverged bases, missing refs, Git-version mismatch, and conflicting idempotency reuse produce explicit non-mutating failures."
    },
    {
      "id": "GITPROVIDER-003-AMBIGUOUS-RECONCILIATION",
      "status": "PASS",
      "tests": [
        "TestProviderReconcilesAmbiguousSuccessfulUpdateAuthoritatively",
        "TestProviderClassifiesRejectedOrTimedOutUnappliedUpdateFromAuthoritativeState"
      ],
      "evidenceFloor": "An ambiguous update acknowledgement is classified only after a detached bounded authoritative read; possible success is recovered and unapplied effects remain failed."
    },
    {
      "id": "GITPROVIDER-004-DUPLICATE-CONVERGENCE",
      "status": "PASS",
      "tests": [
        "TestProviderConcurrentDuplicatesConvergeOnOneHead"
      ],
      "evidenceFloor": "Concurrent duplicate calls converge on the exact planned ref and tree without creating merge commits."
    },
    {
      "id": "GITPROVIDER-005-READ-ONLY-RECONCILE",
      "status": "PASS",
      "tests": [
        "TestProviderReconcileIsReadOnlyAndClassifiesUnmergedAndMergedState"
      ],
      "evidenceFloor": "Reconciliation classifies authoritative unmerged or merged state without invoking a provider mutation."
    },
    {
      "id": "GITPROVIDER-006-LOCAL-BOUNDARY",
      "status": "PASS",
      "tests": [
        "TestProviderFailsClosedOutsideAllowedRootAndWhenGitIsUnavailable"
      ],
      "evidenceFloor": "Repositories outside the allowed root, network URI schemes, and unavailable Git state fail closed without target mutation."
    },
    {
      "id": "GITPROVIDER-007-COORDINATOR-INTEGRATION",
      "status": "PASS",
      "tests": [
        "TestReleaseCoordinatorAndLocalGitProviderCompleteExactPortBoundary"
      ],
      "evidenceFloor": "The accepted coordinator persists contract-valid intent and result commands around one exact local-Git provider effect."
    },
    {
      "id": "GITPROVIDER-008-FORWARD-CONFORMANCE",
