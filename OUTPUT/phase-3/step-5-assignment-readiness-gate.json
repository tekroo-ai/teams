      ],
      "evidenceFloor": "Owned, non-runnable, unsatisfied, invalid, and no-eligible-actor inputs return one stable no-effect result without command or retry loops."
    },
    {
      "id": "ASSIGN-004-DIRECTED-ACTOR-ACCEPTANCE",
      "status": "PASS",
      "tests": [
        "TestAssignmentCoordinatorEmitsReadinessAndExactDispatchWithoutForgingActorAcceptance",
        "TestAssignmentCoordinatorDispatchesReadyTaskFromReadiedEvent",
        "TestAssignmentCoordinatorStopsAfterRejectedStage",
        "TestGatewayCarriesExactAuthenticatedContextToTypedService",
        "TestGatewayRejectsIdentityFenceAndIdempotencyMismatchBeforeService",
        "TestExecutionFencingRequiresExactCurrentTuple",
        "TestStoreSystematicAndConcurrentOneWinnerSchedules"
      ],
      "evidenceFloor": "Policy orders readiness and EXACT dispatch but does not forge actor acceptance; the gateway requires matching authenticated actor/execution context and the frozen kernel/store provide fenced compare-and-set ownership."
    },
    {
      "id": "ASSIGN-005-REPLAY-RESTART",
      "status": "PASS",
      "tests": [
        "TestAssignmentCoordinatorReplayUsesIdenticalCommands",
        "TestAssignmentPlanPreservesActorFQNAcrossExecutionRestart"
      ],
      "evidenceFloor": "Replay emits identical stable commands; actor FQN remains durable while a restarted execution tuple changes independently."
    },
    {
